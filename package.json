{
  "name": "@verndale/ui-design-brain",
  "version": "1.16.1",
  "private": false,
  "description": "Versioned catalog of production-grade UI component patterns (markdown + manifest) shared across Verndale AI tooling, distributed as an agent skill.",
  "license": "MIT",
  "author": "Verndale",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verndale/ui-design-brain.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "bin": {
    "ui-design-brain": "bin/ui-design-brain.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "schemas/",
    "skills/ui-design-brain/",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "ui",
    "design-system",
    "components",
    "patterns",
    "catalog",
    "accessibility",
    "agent-skill"
  ],
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "prepare": "husky",
    "prepack": "pnpm run catalog:check",
    "commit": "ai-commit run",
    "pr:create": "ai-pr",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:staged": "lint-staged",
    "lint:commit": "commitlint --config commitlint.config.cjs",
    "lint:commits:last": "pnpm run lint:commit --last",
    "release:dry": "semantic-release --dry-run",
    "release:preflight": "node scripts/check-release-commit.cjs",
    "release:preflight:selftest": "node scripts/check-release-commit.selftest.cjs",
    "catalog:build": "node bin/ui-design-brain.mjs build",
    "catalog:check": "node bin/ui-design-brain.mjs build --check",
    "test:fast": "pnpm run catalog:check && pnpm run graph:check",
    "test:lifecycle": "node --test scripts/tests/*.test.cjs scripts/tests/*.test.mjs",
    "test": "pnpm run test:fast && pnpm run test:lifecycle && pnpm release:preflight:selftest",
    "verify:push": "pnpm run test",
    "verify:ci": "pnpm run lint && pnpm run test",
    "graph:build": "node scripts/graph/build-graph.cjs",
    "graph:view": "node scripts/graph/serve.cjs",
    "graph:navigate": "node scripts/wiki/navigate.cjs",
    "graph:check": "pnpm run evals:graph",
    "evals:graph": "node scripts/evals/graph-check.cjs",
    "wiki:check": "node --test scripts/tests/wiki-standard.test.cjs && pnpm run graph:check",
    "wiki:archive-plan": "node scripts/wiki/archive-plan.cjs",
    "wiki:find-plans": "node scripts/wiki/find-unarchived-plans.cjs",
    "wiki:issue-sync": "node scripts/wiki/refresh-issue-state.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@verndale/ai-commit": "2.7.0",
    "@verndale/ai-pr": "^1.3.5",
    "dotenv": "^17.4.2",
    "eslint": "10.9.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "semantic-release": "^25.0.3"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": "eslint --fix --max-warnings=0 --no-warn-ignored"
  }
}
