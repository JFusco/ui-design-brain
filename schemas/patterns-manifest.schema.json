{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JFusco/ui-design-brain/v1.18.3/schemas/patterns-manifest.schema.json",
  "title": "UI Design Brain patterns manifest",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "slug", "aliases", "file"],
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "aliases": {
        "type": "array",
        "items": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "context"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "context": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      },
      "file": { "type": "string", "pattern": "^patterns/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$" }
    }
  }
}
